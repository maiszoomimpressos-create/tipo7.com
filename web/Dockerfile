FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG AUTOSAVE_API_URL
ARG AUTOSAVE_API_KEY
ARG AUTOSAVE_WEBHOOK_SECRET
ARG GOOGLE_CLIENT_ID
ARG GOOGLE_CLIENT_SECRET
ARG GOOGLE_PLACES_API_KEY
ARG MP_ACCESS_TOKEN
ARG MP_CLIENT_ID
ARG MP_CLIENT_SECRET
ARG MP_WEBHOOK_SECRET
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_MP_PUBLIC_KEY
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_SUPABASE_URL
ARG PAGBANK_ENV
ARG PAGBANK_TOKEN
ARG PAGBANK_CLIENT_ID
ARG PAGBANK_CLIENT_SECRET
ARG PAGBANK_ACCOUNT_ID
ARG QR_SECRET
ARG RESEND_API_KEY
ARG SUPABASE_ACCESS_TOKEN
ARG SUPABASE_SERVICE_ROLE_KEY

ENV AUTOSAVE_API_URL=$AUTOSAVE_API_URL \
    AUTOSAVE_API_KEY=$AUTOSAVE_API_KEY \
    AUTOSAVE_WEBHOOK_SECRET=$AUTOSAVE_WEBHOOK_SECRET \
    GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID \
    GOOGLE_CLIENT_SECRET=$GOOGLE_CLIENT_SECRET \
    GOOGLE_PLACES_API_KEY=$GOOGLE_PLACES_API_KEY \
    MP_ACCESS_TOKEN=$MP_ACCESS_TOKEN \
    MP_CLIENT_ID=$MP_CLIENT_ID \
    MP_CLIENT_SECRET=$MP_CLIENT_SECRET \
    MP_WEBHOOK_SECRET=$MP_WEBHOOK_SECRET \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_MP_PUBLIC_KEY=$NEXT_PUBLIC_MP_PUBLIC_KEY \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY \
    NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    PAGBANK_ENV=$PAGBANK_ENV \
    PAGBANK_TOKEN=$PAGBANK_TOKEN \
    PAGBANK_CLIENT_ID=$PAGBANK_CLIENT_ID \
    PAGBANK_CLIENT_SECRET=$PAGBANK_CLIENT_SECRET \
    PAGBANK_ACCOUNT_ID=$PAGBANK_ACCOUNT_ID \
    QR_SECRET=$QR_SECRET \
    RESEND_API_KEY=$RESEND_API_KEY \
    SUPABASE_ACCESS_TOKEN=$SUPABASE_ACCESS_TOKEN \
    SUPABASE_SERVICE_ROLE_KEY=$SUPABASE_SERVICE_ROLE_KEY \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/package-lock.json ./package-lock.json
RUN npm ci --omit=dev

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/next.config.mjs ./next.config.mjs

EXPOSE 3000
CMD ["npm", "run", "start"]
