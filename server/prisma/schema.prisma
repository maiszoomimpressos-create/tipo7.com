  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  details      Json?
  ip           String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([action])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model RateLimitRequest {
  id        BigInt   @id @default(dbgenerated("nextval('rate_limit_requests_id_seq'::regclass)"))
  ip        String
  key       String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ip, key, createdAt])
  @@map("rate_limit_requests")
}
