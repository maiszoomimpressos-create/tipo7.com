// ==================================================================
// Schema Prisma gerado a partir de introspeccao manual via SQL
// (npx prisma db pull bloqueado nesta maquina por politica WDAC).
// Fonte: information_schema/pg_catalog do Postgres da Supabase
// (projeto emgkdnxvdfbdhsqmykom), consultado via Management API
// read-only em 03/08/2026. Fase 0 do plano de migracao NestJS/Prisma.
//
// organization_members: tabela legada NAO modelada aqui - confirmado
// 0 linhas em producao, substituida por organization_admins.
//
// user_order_stats: e uma VIEW (nao tabela) - agregado de orders por
// usuario. Nao modelada como Prisma model; recalcular via query/
// service quando a rota admin/usuarios for portada.
// ==================================================================

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==================================================================
// Enums
// ==================================================================

enum EventPermission {
  validar_ingresso
  ver_lista_convidados
  ver_relatorios
  gerenciar_checkin
  gerenciar_equipe
  vender_ingresso
  gerenciar_estacionamento
  estacionamento_entrada
  estacionamento_saida

  @@map("event_permission")
}

enum EventStatus {
  rascunho
  publicado
  cancelado
  encerrado

  @@map("event_status")
}

enum OrganizationType {
  promotora
  estabelecimento

  @@map("organization_type")
}

enum PlatformRole {
  comprador
  promotor
  estabelecimento
  gestor
  admin

  @@map("platform_role")
}

enum TicketMode {
  individual
  pacote
  ambos

  @@map("ticket_mode")
}

// ==================================================================
// Identidade & Organizacoes
// ==================================================================

model Profile {
  // Fase 6: id deixa de ser FK solta pra auth.users(id) da Supabase e vira
  // dono da própria identidade (email + senha) — mesmo uuid preservado na
  // migração de dados, então nenhuma FK no resto do schema precisa mudar.
  id                        String                   @id @db.Uuid
  email                     String                   @unique
  encryptedPassword         String?                  @map("encrypted_password")
  emailVerified             Boolean                  @default(false) @map("email_verified")
  fullName                  String?                  @map("full_name")
  cpf                       String?                  @unique
  phone                     String?                  @unique
  avatarUrl                 String?                  @map("avatar_url")
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  birthDate                 DateTime?                @map("birth_date") @db.Date
  zipCode                   String?                  @map("zip_code")
  street                    String?
  streetNumber              String?                  @map("street_number")
  neighborhood              String?
  city                      String?
  state                     String?                  @db.VarChar(2)
  addressType               String?                  @map("address_type")
  complement                String?
  rg                        String?
  userCode                  String                   @unique @map("user_code")
  refreshTokens             RefreshToken[]           @relation("RefreshToken_userId")
  passwordResetTokens       PasswordResetToken[]     @relation("PasswordResetToken_userId")
  auditLogs                 AuditLog[]               @relation("AuditLog_userId")
  estacionamentoSessoes     EstacionamentoSessao[]   @relation("EstacionamentoSessao_registradoPor")
  estacionamentos           Estacionamento[]         @relation("Estacionamento_createdBy")
  eventStaffsProfile        EventStaff[]             @relation("EventStaff_invitedBy")
  eventStaffsUser           EventStaff[]             @relation("EventStaff_userId")
  events                    Event[]                  @relation("Event_createdBy")
  feeRulesProfile           FeeRule[]                @relation("FeeRule_createdBy")
  feeRulesUser              FeeRule[]                @relation("FeeRule_userId")
  organizationAdminsProfile OrganizationAdmin[]      @relation("OrganizationAdmin_invitedBy")
  organizationAdminsUser    OrganizationAdmin[]      @relation("OrganizationAdmin_userId")
  organizations             Organization[]           @relation("Organization_ownerId")
  platformTeamsProfile      PlatformTeam[]           @relation("PlatformTeam_addedBy")
  platformTeamsUser         PlatformTeam[]           @relation("PlatformTeam_userId")
  promotorMpAccounts        PromotorMpAccount[]      @relation("PromotorMpAccount_userId")
  promotorPagbankAccounts   PromotorPagbankAccount[] @relation("PromotorPagbankAccount_userId")
  ticketValidations         TicketValidation[]       @relation("TicketValidation_scannedBy")
  tickets                   Ticket[]                 @relation("Ticket_validatedBy")
  userPlatformRoles         UserPlatformRole[]       @relation("UserPlatformRole_userId")
  venueAdminsProfile        VenueAdmin[]             @relation("VenueAdmin_invitedBy")
  venueAdminsUser           VenueAdmin[]             @relation("VenueAdmin_userId")

  @@map("profiles")
}

// Sessões emitidas pelo AuthModule próprio (Fase 6). Guarda o hash do
// refresh token, não o valor cru — permite revogar sessão por sessão
// (multi-dispositivo: scanner, caixa, promotor no desktop).
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      Profile   @relation("RefreshToken_userId", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("refresh_tokens")
}

// Tokens de recuperação de senha (Fase 6) — expiração curta, uso único.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      Profile   @relation("PasswordResetToken_userId", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("password_reset_tokens")
}

model UserPlatformRole {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  user      Profile      @relation("UserPlatformRole_userId", fields: [userId], references: [id], onDelete: Cascade)
  role      PlatformRole
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, role])
  @@map("user_platform_roles")
}

model Organization {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  type                 OrganizationType
  ownerId              String?             @map("owner_id") @db.Uuid
  owner                Profile?            @relation("Organization_ownerId", fields: [ownerId], references: [id], onDelete: SetNull)
  logoUrl              String?             @map("logo_url")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  cnpj                 String?             @unique
  nomeFantasia         String?             @map("nome_fantasia")
  codigo               String?             @unique
  phone                String?
  capacity             Int?
  zipCode              String?             @map("zip_code")
  street               String?
  streetNumber         String?             @map("street_number")
  neighborhood         String?
  city                 String?
  state                String?             @db.VarChar(2)
  complement           String?
  contratoTipo         String?             @map("contrato_tipo")
  mensalidadeValidaAte DateTime?           @map("mensalidade_valida_ate") @db.Date
  nicho                String?
  carrosselSlides      CarrosselSlide[]    @relation("CarrosselSlide_organizationId")
  events               Event[]             @relation("Event_organizationId")
  organizationAdmins   OrganizationAdmin[] @relation("OrganizationAdmin_organizationId")
  venues               Venue[]             @relation("Venue_ownerOrgId")

  @@unique([ownerId, type])
  @@map("organizations")
}

model OrganizationAdmin {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("OrganizationAdmin_organizationId", fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id") @db.Uuid
  user           Profile      @relation("OrganizationAdmin_userId", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("admin")
  status         String       @default("ativo")
  invitedBy      String?      @map("invited_by") @db.Uuid
  profile        Profile?     @relation("OrganizationAdmin_invitedBy", fields: [invitedBy], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  participacao   String       @default("integral")
  percentual     Decimal?     @db.Decimal(5, 2)

  @@unique([organizationId, userId])
  @@map("organization_admins")
}

model VenueAdmin {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  venue     Venue    @relation("VenueAdmin_venueId", fields: [venueId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      Profile  @relation("VenueAdmin_userId", fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("admin")
  status    String   @default("ativo")
  invitedBy String?  @map("invited_by") @db.Uuid
  profile   Profile? @relation("VenueAdmin_invitedBy", fields: [invitedBy], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([venueId, userId])
  @@map("venue_admins")
}

model PromotorProfile {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // FK -> users.id(id), Supabase Auth (nao modelado ate a Fase 6)
  userId         String          @unique @map("user_id") @db.Uuid
  tipoPessoa     String          @map("tipo_pessoa")
  tipoEspaco     String          @map("tipo_espaco")
  numSocios      String          @map("num_socios")
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamptz(6)
  promotorSocios PromotorSocio[] @relation("PromotorSocio_promotorId")

  @@map("promotor_profiles")
}

model PromotorSocio {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotorId String          @map("promotor_id") @db.Uuid
  promotor   PromotorProfile @relation("PromotorSocio_promotorId", fields: [promotorId], references: [id], onDelete: Cascade)
  nome       String
  cpf        String
  email      String?
  telefone   String?
  createdAt  DateTime?       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("promotor_socios")
}

// ==================================================================
// Eventos & Conteudo
// ==================================================================

model Event {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId            String                     @map("organization_id") @db.Uuid
  organization              Organization               @relation("Event_organizationId", fields: [organizationId], references: [id], onDelete: Cascade)
  title                     String?
  description               String?
  coverUrl                  String?                    @map("cover_url")
  dateStart                 DateTime?                  @map("date_start") @db.Timestamptz(6)
  dateEnd                   DateTime?                  @map("date_end") @db.Timestamptz(6)
  address                   String?
  city                      String?
  state                     String?
  status                    EventStatus                @default(rascunho)
  createdBy                 String?                    @map("created_by") @db.Uuid
  profile                   Profile?                   @relation("Event_createdBy", fields: [createdBy], references: [id])
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(6)
  venueName                 String?                    @map("venue_name")
  ticketMode                TicketMode?                @map("ticket_mode")
  packageDiscountPct        Int?                       @default(0) @map("package_discount_pct")
  bannerUrl                 String?                    @map("banner_url")
  galleryUrls               String[]                   @default(dbgenerated("ARRAY[]::text[]")) @map("gallery_urls")
  venueId                   String?                    @map("venue_id") @db.Uuid
  venue                     Venue?                     @relation("Event_venueId", fields: [venueId], references: [id])
  capacity                  Int?
  feeMode                   String?                    @default("promotor") @map("fee_mode")
  category                  String?
  zipCode                   String?                    @map("zip_code")
  street                    String?
  streetNumber              String?                    @map("street_number")
  neighborhood              String?
  complement                String?
  vendasOnlinePausadas      Boolean                    @default(false) @map("vendas_online_pausadas")
  transferenciaRequerSenha  Boolean                    @default(false) @map("transferencia_requer_senha")
  paymentGateway            String                     @default("mercadopago") @map("payment_gateway")
  moduloIngressos           Boolean                    @default(true) @map("modulo_ingressos")
  moduloEstacionamento      Boolean                    @default(false) @map("modulo_estacionamento")
  parentEventId             String?                    @map("parent_event_id") @db.Uuid
  parentEvent               Event?                     @relation("Event_parentEventId", fields: [parentEventId], references: [id], onDelete: SetNull)
  moduloTenda               Boolean                    @default(false) @map("modulo_tenda")
  permitirVendaNoCaixaPai   Boolean                    @default(true) @map("permitir_venda_no_caixa_pai")
  lat                       Float?
  lng                       Float?
  caixaTransferencias       CaixaTransferencia[]       @relation("CaixaTransferencia_eventoId")
  caixas                    Caixa[]                    @relation("Caixa_eventoId")
  estacionamentos           Estacionamento[]           @relation("Estacionamento_eventId")
  eventAttributeValues      EventAttributeValue[]      @relation("EventAttributeValue_eventId")
  eventDays                 EventDay[]                 @relation("EventDay_eventId")
  eventPositions            EventPosition[]            @relation("EventPosition_eventId")
  eventPresenceConfigs      EventPresenceConfig[]      @relation("EventPresenceConfig_eventId")
  eventStaffs               EventStaff[]               @relation("EventStaff_eventId")
  eventTickets              EventTicket[]              @relation("EventTicket_eventId")
  events                    Event[]                    @relation("Event_parentEventId")
  feeRules                  FeeRule[]                  @relation("FeeRule_eventId")
  orders                    Order[]                    @relation("Order_eventId")
  presenceEntries           PresenceEntry[]            @relation("PresenceEntry_eventId")
  saldoBilheterias          SaldoBilheteria[]          @relation("SaldoBilheteria_eventId")
  saldoBilheteriaMovimentos SaldoBilheteriaMovimento[] @relation("SaldoBilheteriaMovimento_eventId")
  ticketValidations         TicketValidation[]         @relation("TicketValidation_eventId")

  @@index([organizationId])
  @@index([parentEventId])
  @@index([status])
  @@map("events")
}

model EventPosition {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                  String                    @map("event_id") @db.Uuid
  event                    Event                     @relation("EventPosition_eventId", fields: [eventId], references: [id], onDelete: Cascade)
  name                     String
  description              String?
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  eventPositionPermissions EventPositionPermission[] @relation("EventPositionPermission_eventPositionId")
  eventStaffs              EventStaff[]              @relation("EventStaff_eventPositionId")

  @@map("event_positions")
}

model EventPositionPermission {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventPositionId String          @map("event_position_id") @db.Uuid
  eventPosition   EventPosition   @relation("EventPositionPermission_eventPositionId", fields: [eventPositionId], references: [id], onDelete: Cascade)
  permission      EventPermission

  @@unique([eventPositionId, permission])
  @@map("event_position_permissions")
}

model EventStaff {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId         String                @map("event_id") @db.Uuid
  event           Event                 @relation("EventStaff_eventId", fields: [eventId], references: [id], onDelete: Cascade)
  eventPositionId String?               @map("event_position_id") @db.Uuid
  eventPosition   EventPosition?        @relation("EventStaff_eventPositionId", fields: [eventPositionId], references: [id], onDelete: SetNull)
  userId          String                @map("user_id") @db.Uuid
  user            Profile               @relation("EventStaff_userId", fields: [userId], references: [id], onDelete: Cascade)
  status          String                @default("pending")
  invitedBy       String?               @map("invited_by") @db.Uuid
  profile         Profile?              @relation("EventStaff_invitedBy", fields: [invitedBy], references: [id])
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  portaoId        String?               @map("portao_id") @db.Uuid
  portao          EstacionamentoPortao? @relation("EventStaff_portaoId", fields: [portaoId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@map("event_staff")
}

model EventDay {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId             String               @map("event_id") @db.Uuid
  event               Event                @relation("EventDay_eventId", fields: [eventId], references: [id], onDelete: Cascade)
  dayNumber           Int                  @map("day_number")
  date                DateTime             @db.Date
  startTime           DateTime?            @map("start_time") @db.Time(6)
  endTime             DateTime?            @map("end_time") @db.Time(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  bannerUrl           String?              @map("banner_url")
  eventDayAttractions EventDayAttraction[] @relation("EventDayAttraction_eventDayId")
  eventTickets        EventTicket[]        @relation("EventTicket_eventDayId")

  @@unique([eventId, dayNumber])
  @@index([eventId])
  @@map("event_days")
}

model EventDayAttraction {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventDayId    String    @map("event_day_id") @db.Uuid
  eventDay      EventDay  @relation("EventDayAttraction_eventDayId", fields: [eventDayId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  orderIndex    Int?      @default(0) @map("order_index")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  scheduledTime DateTime? @map("scheduled_time") @db.Time(6)
  imageUrl      String?   @map("image_url")

  @@map("event_day_attractions")
}

model EventTicket {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String      @map("event_id") @db.Uuid
  event       Event       @relation("EventTicket_eventId", fields: [eventId], references: [id], onDelete: Cascade)
  eventDayId  String?     @map("event_day_id") @db.Uuid
  eventDay    EventDay?   @relation("EventTicket_eventDayId", fields: [eventDayId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal     @default(0) @db.Decimal(10, 2)
  quantity    Int         @default(0)
  orderIndex  Int?        @default(0) @map("order_index")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  orderItems  OrderItem[] @relation("OrderItem_ticketId")

  @@index([eventDayId])
  @@index([eventId])
  @@map("event_tickets")
}

model EventAttribute {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  icon                 String                @default("Tag")
  active               Boolean               @default(true)
  orderIndex           Int                   @default(0) @map("order_index")
  createdAt            DateTime?             @default(now()) @map("created_at") @db.Timestamptz(6)
  eventAttributeValues EventAttributeValue[] @relation("EventAttributeValue_attributeId")

  @@map("event_attributes")
}

model EventAttributeValue {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String         @map("event_id") @db.Uuid
  event       Event          @relation("EventAttributeValue_eventId", fields: [eventId], references: [id], onDelete: Cascade)
  attributeId String         @map("attribute_id") @db.Uuid
  attribute   EventAttribute @relation("EventAttributeValue_attributeId", fields: [attributeId], references: [id], onDelete: Cascade)
  createdAt   DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  valueJson   Json?          @map("value_json")

  @@unique([eventId, attributeId])
  @@map("event_attribute_values")
}

model Venue {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  googlePlaceId String?       @unique @map("google_place_id")
  zipCode       String?       @map("zip_code")
  street        String?
  streetNumber  String?       @map("street_number")
  neighborhood  String?
  city          String?
  state         String?       @db.VarChar(2)
  complement    String?
  lat           Decimal?      @db.Decimal(10, 7)
  lng           Decimal?      @db.Decimal(10, 7)
  capacity      Int?
  ownerOrgId    String?       @map("owner_org_id") @db.Uuid
  ownerOrg      Organization? @relation("Venue_ownerOrgId", fields: [ownerOrgId], references: [id])
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  hasParking    Boolean?      @map("has_parking")
  parkingSpots  Int?          @map("parking_spots")
  codigo        String?       @unique
  cnpj          String?       @unique
  nomeFantasia  String?       @map("nome_fantasia")
  nicho         String?
  phone         String?
  events        Event[]       @relation("Event_venueId")
  venueAdmins   VenueAdmin[]  @relation("VenueAdmin_venueId")

  @@map("venues")
}

model CarrosselSlide {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("CarrosselSlide_organizationId", fields: [organizationId], references: [id], onDelete: Cascade)
  imageUrl       String       @map("image_url")
  storagePath    String       @map("storage_path")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("carrossel_slides")
}

model SystemBanner {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imageUrl   String   @map("image_url")
  active     Boolean  @default(true)
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("system_banners")
}

model PlatformContent {
  key       String   @id
  content   String   @default("")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("platform_content")
}

// ==================================================================
// Comercio / Ticketing
// ==================================================================

model Order {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // FK -> users.id(id), Supabase Auth (nao modelado ate a Fase 6)
  userId                    String?                    @map("user_id") @db.Uuid
  eventId                   String                     @map("event_id") @db.Uuid
  event                     Event                      @relation("Order_eventId", fields: [eventId], references: [id], onDelete: Cascade)
  status                    String                     @default("pending")
  total                     Decimal                    @default(0) @db.Decimal(10, 2)
  mpPreferenceId            String?                    @map("mp_preference_id")
  mpPaymentId               String?                    @map("mp_payment_id")
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(6)
  pixQrCode                 String?                    @map("pix_qr_code")
  pixQrCodeBase64           String?                    @map("pix_qr_code_base64")
  pixExpiresAt              DateTime?                  @map("pix_expires_at") @db.Timestamptz(6)
  paymentMethod             String?                    @map("payment_method")
  caixaId                   String?                    @map("caixa_id") @db.Uuid
  caixa                     Caixa?                     @relation("Order_caixaId", fields: [caixaId], references: [id])
  gateway                   String                     @default("mercadopago")
  pagbankChargeId           String?                    @map("pagbank_charge_id")
  pagbankPixQrCode          String?                    @map("pagbank_pix_qr_code")
  pagbankPixExpiresAt       DateTime?                  @map("pagbank_pix_expires_at") @db.Timestamptz(6)
