<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        tools:replace="android:allowBackup"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher_placeholder"
        android:theme="@style/Theme.Tipo7Caixa"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- usesCleartextTraffic=true só importa pro BASE_URL_DEBUG (http://
             na rede local). Build de release deve apontar pra https:// de
             verdade — não desliga a validação de certificado, só permite
             http:// quando o host for explicitamente marcado no network
             security config abaixo. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Categorias HOME/DEFAULT: permitem o app virar a "tela
                 inicial" do aparelho (ver DevicePolicyManager.
                 addPersistentPreferredActivity no MainActivity — exige
                 Device Owner pra virar automático sem prompt). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Gatilho de teste da impressora térmica, só via ADB — ver
             PrintTestReceiver.kt. exported=true pra `am broadcast` externo
             conseguir chamar; não é um risco real (só imprime um texto
             fixo de teste, sem ler nada sensível). -->
        <receiver
            android:name=".PrintTestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="br.com.tipo7.caixa.TESTE_IMPRESSAO" />
            </intent-filter>
        </receiver>

        <!-- Válvula de escape do kiosk (Device Owner), só por ADB — ver
             KioskControlReceiver.kt. -->
        <receiver
            android:name=".KioskControlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="br.com.tipo7.caixa.KIOSK_DESATIVAR" />
            </intent-filter>
        </receiver>

        <!-- Auto-início ao ligar o aparelho — terminal de bancada fixo,
             ver BootReceiver.kt. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Pré-requisito técnico do Android pra virar Device Owner — ver
             AdminReceiver.kt e docs/maquininha-gpos780-levantamento-requisitos.md. -->
        <receiver
            android:name=".AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
